import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "TI5X.Avalonia" / "docs" / "ti-59.svg"
OUT = ROOT / "TI5X.Avalonia" / "src" / "TI5X.Avalonia.Android" / "Resources"
# Single-source MAUI app icon, pre-rendered as PNG: MAUI's resizetizer
# (Svg.Skia + bundled SkiaSharp) crashes on <text> and <filter> elements
# (MissingMethodException in SKTypeface.Clone / SKImageFilter.CreateMatrix-
# Convolution), so the icon is rasterized here with rsvg-convert instead.
# csproj: <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#181615" />
MAUI_ICON = ROOT / "TI5X.Avalonia" / "src" / "TI5X.Maui" / "Resources" / "AppIcon" / "appicon.png"
MAUI_ICON_PX = 1024

# ti-59.svg viewBox: 0 0 800 1220
ASPECT = 800 / 1220

TILE_SQUARE = '<rect x="0.6" y="0.6" width="98.8" height="98.8" rx="2" fill="#181615" stroke="#2B2B2B" stroke-width="0.6"/>'
TILE_CIRCLE = '<circle cx="50" cy="50" r="49.4" fill="#181615" stroke="#2B2B2B" stroke-width="0.6"/>'
# MAUI tile: same rounded square as the previous appicon.svg (rx 72 of 456)
TILE_MAUI = '<rect width="456" height="456" rx="72" fill="#181615"/>'

DENSITIES = [
    ("mdpi", 48, 108),
    ("hdpi", 72, 162),
    ("xhdpi", 96, 216),
    ("xxhdpi", 144, 324),
    ("xxxhdpi", 192, 432),
]


def svg_body(path):
    "inner content of the source svg (everything between <svg...> and </svg>)"
    text = path.read_text(encoding="utf-8")
    start = text.index(">", text.index("<svg")) + 1
    end = text.rindex("</svg>")
    return text[start:end]


def wrapper(body, tile, height, space=100):
    "design space (default 100x100): optional tile + calculator fitted by height, centred"
    s = height / 1220
    w = 800 * s
    x = (space - w) / 2
    y = (space - height) / 2
    return (
        f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {space} {space}">\n'
        f"  {tile}\n"
        f'  <g transform="translate({x:.4f} {y:.4f}) scale({s:.6f})">\n'
        f"{body}\n"
        "  </g>\n"
        "</svg>\n"
    )


def main():
    if shutil.which("rsvg-convert") is None:
        sys.exit("error: rsvg-convert not found (brew install librsvg)")
    if not SRC.is_file():
        sys.exit(f"error: missing {SRC}")

    body = svg_body(SRC)
    variants = {
        "legacy": wrapper(body, TILE_SQUARE, 78),
        "round": wrapper(body, TILE_CIRCLE, 62),
        "foreground": wrapper(body, "", 62),
    }
    # MAUI single-source icon (PNG): full-bleed tile (rx 72 of 456) +
    # calculator at 62% height, rasterized by rsvg-convert (text and filters
    # included - MAUI's resizetizer cannot parse them, see MAUI_ICON note)
    maui_svg = wrapper(body, TILE_MAUI, 0.62 * 456, space=456)

    with tempfile.TemporaryDirectory() as tmp:
        paths = {}
        for name, svg in variants.items():
            p = Path(tmp) / f"{name}.svg"
            p.write_text(svg, encoding="utf-8")
            paths[name] = p

        maui_path = Path(tmp) / "maui.svg"
        maui_path.write_text(maui_svg, encoding="utf-8")
        MAUI_ICON.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(
            ["rsvg-convert", "-w", str(MAUI_ICON_PX), "-h", str(MAUI_ICON_PX),
             str(maui_path), "-o", str(MAUI_ICON)],
            check=True,
        )
        print(f"MAUI icon written: {MAUI_ICON} ({MAUI_ICON_PX}px)")

        for dpi, legacy_px, fg_px in DENSITIES:
            out_dir = OUT / f"mipmap-{dpi}"
            out_dir.mkdir(parents=True, exist_ok=True)
            for name, px, out_name in [
                ("legacy", legacy_px, "ic_launcher.png"),
                ("round", legacy_px, "ic_launcher_round.png"),
                ("foreground", fg_px, "ic_launcher_foreground.png"),
            ]:
                subprocess.run(
                    ["rsvg-convert", "-w", str(px), "-h", str(px),
                     str(paths[name]), "-o", str(out_dir / out_name)],
                    check=True,
                )
            print(f"mipmap-{dpi}: ic_launcher/round {legacy_px}px, foreground {fg_px}px")

    print(f"icons written under {OUT}/mipmap-*")


main()