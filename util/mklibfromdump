import sys
import os
import re
import zipfile

MIMETYPE = b"application/vnd.nz.gen.geek_central.ti5x"
ROM_SIZE = 5000
MAX_PROG = 1000 # engine limit for a library bank

class Failure(Exception) :
    pass
#end Failure

def fail(msg) :
    raise Failure(msg)
#end fail

def parse_dump(path) :
    "Returns (module_name, memory) where memory is a list of ROM_SIZE bytes."
    mem = [None] * ROM_SIZE
    module_name = None
    with open(path, "r", encoding = "utf-8", errors = "replace") as f :
        lines = f.read().split("\n")
    # module name = 4th header line ("MASTER LIBRARY MODULE -1-" etc.)
    for i, line in enumerate(lines) :
        if line.startswith("DUT:") :
            if i + 1 < len(lines) and lines[i + 1].strip() != "" :
                module_name = lines[i + 1].strip()
            #end if
            break
        #end if
    #end for
    data_re = re.compile(r"^(\d{4}):\s+((?:\d{2} )+\d{2})\s*$")
    for line in lines :
        m = data_re.match(line)
        if m == None :
            continue
        #end if
        addr = int(m.group(1))
        if addr >= ROM_SIZE :
            fail("address %04d out of range in dump" % addr)
        #end if
        for i, tok in enumerate(m.group(2).split()) :
            val = int(tok)
            if not 0 <= val <= 99 :
                fail("bad BCD value %r at address %04d" % (tok, addr + i))
            #end if
            if addr + i >= ROM_SIZE :
                fail("dump data exceeds %d bytes" % ROM_SIZE)
            #end if
            mem[addr + i] = val
        #end for
    #end for
    if any(v is None for v in mem) :
        missing = mem.index(None)
        fail("dump is incomplete, first gap at address %04d" % missing)
    #end if
    if module_name == None :
        fail("module name header not found")
    #end if
    return module_name, mem
#end parse_dump

def parse_listing(path) :
    "Returns list of (nr, start, length, code, title) from the -PGMSUTF8 listing."
    result = []
    count_seen = None
    prog_re = re.compile(r"^#(\d\d):\s+(\d{4})\s+(\d{4})\s+(\S+)\s+(.+?)\s*$")
    with open(path, "r", encoding = "utf-8", errors = "replace") as f :
        for line in f :
            m_count = re.match(r"^Number of Programs:\s+(\d+)", line)
            if m_count != None :
                count_seen = int(m_count.group(1))
                continue
            #end if
            m = prog_re.match(line)
            if m != None :
                result.append \
                  (
                    (
                        int(m.group(1)),
                        int(m.group(2)),
                        int(m.group(3)),
                        m.group(4),
                        m.group(5),
                    )
                )
            #end if
        #end for
    #end with
    return count_seen, result
#end parse_listing

def xml_escape(s) :
    return \
        s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;")
#end xml_escape

def prog_xml(codes) :
    lines = []
    for i in range(0, len(codes), 16) :
        lines.append(" " * 12 + " ".join("%02d" % c for c in codes[i : i + 16]))
    #end for
    return \
        (
            "<state>\n    <calc>\n        <prog>\n"
        +
            "\n".join(lines)
        +
            "\n        </prog>\n    </calc>\n</state>\n"
        ).encode("utf-8")
#end prog_xml

def card_xml(code, title) :
    return \
        (
            "<carddef style=\"system\">\n"
            "  <label slot=\"titleleft\">%s</label>\n"
            "  <label slot=\"titleright\">%s</label>\n"
            "</carddef>\n"
        %
            (xml_escape(title), xml_escape(code))
        ).encode("utf-8")
#end card_xml

def build(dump_path, listing_path, out_path) :
    module_name, mem = parse_dump(dump_path)
    count_listing, listing = parse_listing(listing_path)
    nr_programs = mem[0]
    protected = mem[1]
    if not 1 <= nr_programs <= 99 :
        fail("implausible program count %d" % nr_programs)
    #end if
    if count_listing != None and count_listing != nr_programs :
        fail("program count mismatch: dump %d vs listing %d" % (nr_programs, count_listing))
    #end if
    if protected not in (0, 1) :
        fail("implausible copy-protection flag %d" % protected)
    #end if
    start = []
    for k in range(1, nr_programs + 2) :
        # program k starts at pointer address 2*k; the final pointer
        # at 2*N+2 marks the end of the last program
        hi = mem[2 * k]
        lo = mem[2 * k + 1]
        addr = hi * 100 + lo
        start.append(addr)
    #end for
    out = zipfile.ZipFile(out_path, mode = "w", compression = zipfile.ZIP_DEFLATED)
    mimetype = zipfile.ZipInfo()
    mimetype.filename = "mimetype"
    mimetype.compress_type = zipfile.ZIP_STORED
    mimetype.external_attr = 0o644 << 16
    mimetype.date_time = (2011, 4, 14, 13, 8, 44) # matches makeprog convention
    out.writestr(mimetype, MIMETYPE)
    listing_by_nr = {entry[0] : entry for entry in listing}
    total = 0
    for k in range(1, nr_programs + 1) :
        addr = start[k - 1]
        end = start[k]
        if not addr <= end <= ROM_SIZE :
            fail("implausible address range %04d..%04d for program %02d" % (addr, end, k))
        #end if
        codes = mem[addr : end]
        out.writestr("prog%02d" % k, prog_xml(codes))
        if addr == end :
            # an unallocated program slot (e.g. RE-17): keep the empty
            # bank so "2nd Pgm k" behaves like the real module, but no card
            continue
        #end if
        if len(codes) > MAX_PROG :
            sys.stderr.write("warning: program %02d has %d steps, engine caps banks at %d\n" % (k, len(codes), MAX_PROG))
        #end if
        entry = listing_by_nr.get(k)
        code, title = None, None
        if entry != None :
            lnr, lstart, llength, code, title = entry
            if lstart != addr :
                fail("program %02d start mismatch: dump %04d vs listing %04d" % (k, addr, lstart))
            #end if
            if llength != end - addr :
                fail("program %02d length mismatch: dump %d vs listing %d" % (k, end - addr, llength))
            #end if
        else :
            sys.stderr.write("warning: program %02d not found in listing, generating generic card\n" % k)
            code, title = "PGM-%02d" % k, "PROGRAM"
        #end if
        out.writestr("card%02d" % k, card_xml(code, title))
        total += len(codes)
    #end for
    out.close()
    sys.stderr.write \
      (
            "%s: %d programs, %d key codes"
        %
            (out_path, nr_programs, total)
      )
    if protected :
        sys.stderr.write(", copy-protected flag set in ROM")
    #end if
    sys.stderr.write("\n")
#end build

if len(sys.argv) != 4 :
    sys.stderr.write("usage: %s dumpfile listingfile outfile\n" % os.path.basename(sys.argv[0]))
    sys.exit(1)
#end if
try :
    build(sys.argv[1], sys.argv[2], sys.argv[3])
except Failure as err :
    sys.stderr.write("error: %s\n" % err)
    sys.exit(1)
#end try