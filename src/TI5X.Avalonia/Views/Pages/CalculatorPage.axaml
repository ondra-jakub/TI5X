<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TI5X.ViewModels"
             xmlns:views="using:TI5X.Avalonia.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="820"
             x:Class="TI5X.Avalonia.Views.Pages.CalculatorPage"
             x:DataType="vm:MainViewModel">

    <!-- The app menu is reachable from the ☰ button under the display (see
         CalculatorView); this root page needs no top command bar, so the whole
         screen stays dark. Wide screens additionally show the printer pane
         (see CalculatorShell). -->
    <views:CalculatorShell />
</ContentPage>