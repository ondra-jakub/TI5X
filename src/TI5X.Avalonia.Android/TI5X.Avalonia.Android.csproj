<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <RootNamespace>TI5X.Avalonia.Android</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Avalonia.Android 12.x (AndroidX lifecycle runtime) requires minSdk >= 23;
         the official Avalonia Android template uses 23 as well (plan assumed 21). -->
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <ApplicationId>jakub.cloud.ti5x.avalonia</ApplicationId>
    <ApplicationTitle>TI5X (Avalonia)</ApplicationTitle>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Debug builds embed the assemblies too, so `dotnet build -c Debug` + adb install
         runs without the IDE fast-deployment step (which crashes with no override dir). -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- The head references the desktop WinExe (shared UI/pages); the Android output
         is self-contained, so the executable-reference check must be disabled. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>
  <ItemGroup>
    <!-- The desktop project stays a single-TFM (net10.0) WinExe; building it must not
         inherit the Android RuntimeIdentifier/SelfContained globals. -->
    <ProjectReference Include="..\TI5X.Avalonia\TI5X.Avalonia.csproj"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>
</Project>