<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>TI5X.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>TI5X</ApplicationTitle>
    <ApplicationId>jakub.cloud.ti5x.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pre-rendered from docs/ti-59.svg by util/makeicons-ti59 (rsvg-convert);
         MAUI's resizetizer cannot parse the SVG (text/filters) so a PNG is
         used as the single icon source for all densities and adaptive icons. -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#181615" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#181615" BaseSize="128,128" />
    <MauiAsset Include="Resources\Raw\**"
               LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Maui.Resizetizer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TI5X.Core\TI5X.Core.csproj" />
    <ProjectReference Include="..\TI5X.ViewModels\TI5X.ViewModels.csproj" />
  </ItemGroup>
</Project>
