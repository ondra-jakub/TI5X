<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TI5X.Maui.Controls"
             xmlns:vm="clr-namespace:TI5X.ViewModels;assembly=TI5X.ViewModels"
             x:Class="TI5X.Maui.MainPage"
             x:DataType="vm:MainViewModel"
             Title="TI5X"
             BackgroundColor="#181615"
             SafeAreaEdges="All">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Menu" Clicked="OnMenuClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,8">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="TEXAS INSTRUMENTS" FontSize="11" FontAttributes="Bold" TextColor="#C8BFB5" CharacterSpacing="1" />
                <Label Text="TI-59" FontSize="11" FontAttributes="Bold" TextColor="#E6B432" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <Border BackgroundColor="#332B25" StrokeThickness="0" StrokeShape="RoundRectangle 3" Padding="6,2">
                    <Label Text="{Binding AngleModeText}" FontSize="9" FontAttributes="Bold" TextColor="#E6B432" />
                </Border>
                <Border BackgroundColor="#332B25" StrokeThickness="0" StrokeShape="RoundRectangle 3" Padding="6,2" IsVisible="{Binding IsSecondActive}">
                    <Label Text="2nd" FontSize="9" FontAttributes="Bold" TextColor="#F5D061" />
                </Border>
                <Border BackgroundColor="#332B25" StrokeThickness="0" StrokeShape="RoundRectangle 3" Padding="6,2" IsVisible="{Binding IsInvActive}">
                    <Label Text="INV" FontSize="9" FontAttributes="Bold" TextColor="#E06040" />
                </Border>
                <Border BackgroundColor="#332B25" StrokeThickness="0" StrokeShape="RoundRectangle 3" Padding="6,2" IsVisible="{Binding IsLrnActive}">
                    <Label Text="LRN" FontSize="9" FontAttributes="Bold" TextColor="#FF3333" />
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <Border Grid.Row="1"
                BackgroundColor="#100202"
                Stroke="#400A0A"
                StrokeThickness="3"
                StrokeShape="RoundRectangle 6"
                HeightRequest="64"
                Margin="0,0,0,10">
            <controls:LedDisplayView Text="{Binding DisplayText}"
                                     IsError="{Binding IsError}"
                                     IsRunning="{Binding IsRunning}"
                                     Margin="6,4" />
        </Border>

        <Border Grid.Row="2"
                BackgroundColor="#2B2623"
                Stroke="#4A423D"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 4"
                HeightRequest="50"
                Margin="0,0,0,8"
                Padding="2">
            <controls:CardStripView Card="{Binding CurrentCard}" />
        </Border>

        <Grid Grid.Row="3" Margin="0,4,0,4"
              RowDefinitions="*,*,*,*,*,*,*,*,*"
              ColumnDefinitions="*,*,*,*,*">

            <controls:KeyButtonView Grid.Row="0" Grid.Column="0" KeyText="A" AltText="A´" KeyCode="11" StyleType="TopRow" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="0" Grid.Column="1" KeyText="B" AltText="B´" KeyCode="12" StyleType="TopRow" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="0" Grid.Column="2" KeyText="C" AltText="C´" KeyCode="13" StyleType="TopRow" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="0" Grid.Column="3" KeyText="D" AltText="D´" KeyCode="14" StyleType="TopRow" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="0" Grid.Column="4" KeyText="E" AltText="E´" KeyCode="15" StyleType="TopRow" Clicked="OnKeyClicked" />

            <controls:KeyButtonView Grid.Row="1" Grid.Column="0" KeyText="2nd" AltText="" KeyCode="21" StyleType="Yellow" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="1" Grid.Column="1" KeyText="INV" AltText="" KeyCode="22" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="1" Grid.Column="2" KeyText="lnx" AltText="log" KeyCode="23" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="1" Grid.Column="3" KeyText="CE" AltText="CP" KeyCode="24" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="1" Grid.Column="4" KeyText="CLR" AltText="" KeyCode="25" StyleType="Yellow" Clicked="OnKeyClicked" />

            <controls:KeyButtonView Grid.Row="2" Grid.Column="0" KeyText="LRN" AltText="Pgm" KeyCode="31" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="2" Grid.Column="1" KeyText="x⇌t" AltText="P→R" KeyCode="32" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="2" Grid.Column="2" KeyText="x²" AltText="sin" KeyCode="33" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="2" Grid.Column="3" KeyText="√x" AltText="cos" KeyCode="34" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="2" Grid.Column="4" KeyText="1/x" AltText="tan" KeyCode="35" StyleType="Standard" Clicked="OnKeyClicked" />

            <controls:KeyButtonView Grid.Row="3" Grid.Column="0" KeyText="SST" AltText="Ins" KeyCode="41" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="3" Grid.Column="1" KeyText="STO" AltText="CMs" KeyCode="42" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="3" Grid.Column="2" KeyText="RCL" AltText="Exc" KeyCode="43" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="3" Grid.Column="3" KeyText="SUM" AltText="Prd" KeyCode="44" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="3" Grid.Column="4" KeyText="yˣ" AltText="Ind" KeyCode="45" StyleType="Standard" Clicked="OnKeyClicked" />

            <controls:KeyButtonView Grid.Row="4" Grid.Column="0" KeyText="BST" AltText="Del" KeyCode="51" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="4" Grid.Column="1" KeyText="EE" AltText="Eng" KeyCode="52" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="4" Grid.Column="2" KeyText="(" AltText="Fix" KeyCode="53" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="4" Grid.Column="3" KeyText=")" AltText="Int" KeyCode="54" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="4" Grid.Column="4" KeyText="÷" AltText="|x|" KeyCode="55" StyleType="Yellow" Clicked="OnKeyClicked" />

            <controls:KeyButtonView Grid.Row="5" Grid.Column="0" KeyText="GTO" AltText="Pause" KeyCode="61" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="5" Grid.Column="1" KeyText="7" AltText="x=t" KeyCode="62" StyleType="Number" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="5" Grid.Column="2" KeyText="8" AltText="Nop" KeyCode="63" StyleType="Number" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="5" Grid.Column="3" KeyText="9" AltText="Op" KeyCode="64" StyleType="Number" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="5" Grid.Column="4" KeyText="×" AltText="Deg" KeyCode="65" StyleType="Yellow" Clicked="OnKeyClicked" />

            <controls:KeyButtonView Grid.Row="6" Grid.Column="0" KeyText="SBR" AltText="Lbl" KeyCode="71" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="6" Grid.Column="1" KeyText="4" AltText="x≥t" KeyCode="72" StyleType="Number" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="6" Grid.Column="2" KeyText="5" AltText="∑+" KeyCode="73" StyleType="Number" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="6" Grid.Column="3" KeyText="6" AltText="x̄" KeyCode="74" StyleType="Number" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="6" Grid.Column="4" KeyText="-" AltText="Rad" KeyCode="75" StyleType="Yellow" Clicked="OnKeyClicked" />

            <controls:KeyButtonView Grid.Row="7" Grid.Column="0" KeyText="RST" AltText="St flg" KeyCode="81" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="7" Grid.Column="1" KeyText="1" AltText="If flg" KeyCode="82" StyleType="Number" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="7" Grid.Column="2" KeyText="2" AltText="D.MS" KeyCode="83" StyleType="Number" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="7" Grid.Column="3" KeyText="3" AltText="π" KeyCode="84" StyleType="Number" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="7" Grid.Column="4" KeyText="+" AltText="Grad" KeyCode="85" StyleType="Yellow" Clicked="OnKeyClicked" />

            <controls:KeyButtonView Grid.Row="8" Grid.Column="0" KeyText="R/S" AltText="" KeyCode="91" StyleType="Standard" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="8" Grid.Column="1" KeyText="0" AltText="Dsz" KeyCode="92" StyleType="Number" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="8" Grid.Column="2" KeyText="." AltText="Adv" KeyCode="93" StyleType="Number" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="8" Grid.Column="3" KeyText="+/-" AltText="Prt" KeyCode="94" StyleType="Number" Clicked="OnKeyClicked" />
            <controls:KeyButtonView Grid.Row="8" Grid.Column="4" KeyText="=" AltText="List" KeyCode="95" StyleType="Yellow" Clicked="OnKeyClicked" />
        </Grid>

        <Label Grid.Row="4"
               Text="{Binding StatusInfo}"
               FontSize="10"
               TextColor="#8A8078"
               HorizontalTextAlignment="Center"
               Margin="0,6,0,0" />
    </Grid>
</ContentPage>
