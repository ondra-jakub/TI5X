<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TI5X.Maui.Controls"
             x:Class="TI5X.Maui.Controls.KeyButtonView"
             x:DataType="controls:KeyButtonView">
    <Grid RowDefinitions="Auto,*" Margin="2">
        <Label Grid.Row="0"
               Text="{Binding AltText}"
               TextColor="#F5D061"
               FontAttributes="Bold"
               FontSize="10"
               HorizontalTextAlignment="Center"
               HeightRequest="14" />

        <Button x:Name="KeyButton"
                Grid.Row="1"
                Text="{Binding KeyText}"
                Clicked="OnButtonClicked"
                CornerRadius="4"
                Padding="0"
                FontAttributes="Bold"
                FontSize="13"
                BorderWidth="1" />
    </Grid>
</ContentView>
