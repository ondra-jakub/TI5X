<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TI5X.ViewModels"
             xmlns:views="using:TI5X.Avalonia.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="820"
             x:Class="TI5X.Avalonia.Views.Pages.CalculatorPage"
             x:DataType="vm:MainViewModel">

    <ContentPage.TopCommandBar>
        <Button x:Name="MenuButton" Content="Menu">
            <Button.Flyout>
                <MenuFlyout>
                    <MenuItem Header="New Program" Click="OnMenuNewProgram" />
                    <MenuItem Header="Open Program (.ti5p)" Click="OnMenuOpenProgram" />
                    <MenuItem Header="Save Program (.ti5p)" Click="OnMenuSaveProgram" />
                    <Separator />
                    <MenuItem Header="Load Library Module (.ti5l)" Click="OnMenuLoadLibrary" />
                    <Separator />
                    <MenuItem Header="Virtual Printer" Click="OnMenuShowPrinter" />
                    <MenuItem Header="Program Debugger" Click="OnMenuShowDebugger" />
                    <MenuItem Header="Help" Click="OnMenuShowHelp" />
                    <MenuItem Header="About" Click="OnMenuShowAbout" />
                    <Separator />
                    <MenuItem Header="Exit" Click="OnMenuExit" />
                </MenuFlyout>
            </Button.Flyout>
        </Button>
    </ContentPage.TopCommandBar>

    <views:CalculatorView />
</ContentPage>