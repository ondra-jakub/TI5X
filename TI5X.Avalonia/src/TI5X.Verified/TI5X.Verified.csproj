<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The compiled output is generated by Dafny; its guarantee comes from
         "dafny verify" in CI, not from C# analyzers, which do not apply
         cleanly to the generated runtime. -->
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RootNamespace>TI5X.Verified</RootNamespace>
    <AssemblyName>TI5X.Verified</AssemblyName>
    <!-- The generated/partition.cs file is picked up by the default compile glob.
         It is generated from partition.dfy by "dafny translate cs" with the
         "include-runtime" option. Regenerate and diff via CI; do not edit by hand. -->
    <GeneratedCode>true</GeneratedCode>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>
</Project>