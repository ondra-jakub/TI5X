+/* ============================================================
+ * Deterministic key script support (-K patch, opt-in).
+ *
+ * Script format (one entry per line, '#' starts a comment):
+ *   <key_code_hex> [not_before_cycle] [hold_scans] [toggle]
+ *
+ * - key_code_hex: matrix code of the key (as in key_table_*),
+ *   written in hex (e.g. 69 for '=', 12 for 2nd, 1B ...).
+ * - not_before_cycle: decimal instruction cycle (bus->cycle_count,
+ *   counted from reset, 1 per S0..S15 instruction cycle) at which
+ *   the entry becomes eligible. The entry is consumed at the
+ *   first "read new key" event (idle scan-all, key_code==0) at or
+ *   after this cycle.
+ * - hold_scans: how many keyboard scan passes the key stays
+ *   pressed (default: 2 = cpu.key_press_cycle, like a real press).
+ * - toggle: instead of a transient press, toggles the persistent
+ *   key bit (same as keys with KEY_ONOFF/KEY_INVERT flag, e.g.
+ *   4A toggle = card reader switch).
+ *
+ * In script mode stdin is never read: scan-row (!scan) reads see
+ * no key and the simulator never exits on EOF (use -n to halt).
+ * ============================================================ */
+struct key_event {
+    unsigned char code;
+    unsigned long long at;
+    int hold;
+    int toggle;
+};
+static struct key_event *script_events;
+static int script_nevents;
+static int script_pos;
+static int script_mode;
+
+int key_script_load(const char *name)
+{
+    FILE *f;
+    char line[256];
+    int n = 0;
+    int cap = 64;
+
+    f = fopen(name, "rt");
+    if (!f) {
+        printf("key script '%s' not found\n", name);
+        return -1;
+    }
+    script_events = malloc(cap * sizeof(*script_events));
+    while (fgets(line, sizeof(line), f)) {
+        unsigned code;
+        unsigned long long at = 0;
+        int hold = 0;
+        char word[16];
+        int toggle = 0;
+        char *p = line;
+        if (line[0] == '#' || line[0] == '\n')
+            continue;
+        if (sscanf(p, "%x", &code) != 1)
+            continue;
+        while (*p && !isspace((unsigned char)*p)) p++;
+        if (sscanf(p, "%llu", &at) < 1)
+            at = 0;
+        while (*p && !isspace((unsigned char)*p)) p++;
+        if (sscanf(p, "%d", &hold) < 1)
+            hold = 0;
+        while (*p && !isspace((unsigned char)*p)) p++;
+        if (sscanf(p, "%15s", word) == 1 && !strcmp(word, "toggle"))
+            toggle = 1;
+        if (n == cap) {
+            cap *= 2;
+            script_events = realloc(script_events, cap * sizeof(*script_events));
+        }
+        script_events[n].code = code;
+        script_events[n].at = at;
+        script_events[n].hold = hold;
+        script_events[n].toggle = toggle;
+        n++;
+    }
+    fclose(f);
+    script_nevents = n;
+    script_pos = 0;
+    script_mode = 1;
+    printf("key script '%s' loaded (%d events)\n", name, n);
+    return 0;
+}
