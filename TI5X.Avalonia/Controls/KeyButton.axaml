<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="70" d:DesignHeight="55"
             x:Class="TI5X.Avalonia.Controls.KeyButton"
             x:Name="Root">

    <Grid RowDefinitions="Auto,*" Margin="2">
        <!-- 2nd upper modifier label -->
        <TextBlock Grid.Row="0"
                   Text="{Binding #Root.AltText}"
                   Foreground="#F5D061"
                   FontWeight="Bold"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,1"
                   Height="13" />

        <!-- Key Button -->
        <Button Grid.Row="1"
                Click="OnButtonClick"
                CornerRadius="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{Binding #Root.ButtonBackground}"
                BorderBrush="{Binding #Root.ButtonBorderBrush}"
                BorderThickness="1"
                Padding="0">
            <TextBlock Text="{Binding #Root.KeyText}"
                       Foreground="{Binding #Root.ButtonForeground}"
                       FontWeight="Bold"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Button>
    </Grid>
</UserControl>
