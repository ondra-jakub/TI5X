<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="TI5X.Core\TI5X.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Source of sibling sub-projects must not leak into the app compilation. -->
    <Compile Remove="TI5X.Core\**" />
    <Compile Remove="TI5X.Core.Tests\**" />
    <Compile Remove="TI5X.Verified\**" />
    <Compile Remove="regen\**" />
    <EmbeddedResource Remove="TI5X.Core\**" />
    <EmbeddedResource Remove="TI5X.Core.Tests\**" />
    <EmbeddedResource Remove="TI5X.Verified\**" />
    <EmbeddedResource Remove="regen\**" />
    <None Remove="TI5X.Core\**" />
    <None Remove="TI5X.Core.Tests\**" />
    <None Remove="TI5X.Verified\**" />
    <None Remove="regen\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*" />
  </ItemGroup>
</Project>